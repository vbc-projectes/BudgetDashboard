# DashboardEconomic — environment variables
# Copy this file to .env and adjust values before running docker compose

# Server port exposed on host
PORT=3000

# Node environment (production | development)
NODE_ENV=production

# Max records returned per query
QUERY_LIMIT=2000

# CORS origin (* allows all; restrict to your domain for production, e.g. http://192.168.1.10:3000)
CORS_ORIGIN=*

# Web Push (notificaciones de pagos próximos). Opcional: si se omiten, el
# servidor genera un par de claves VAPID la primera vez que arranca y las
# guarda en usuarios/.vapid-keys.json — no hace falta configurar nada.
# Defínelas aquí solo si quieres fijarlas explícitamente (p. ej. para no
# perderlas si el volumen de usuarios se recrea) o cambiar el contacto.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:tu-email@dominio.com
